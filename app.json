{
  "expo": {
    "name": "拾光计划",
    "slug": "shiguang-student-planner",
    "version": "1.0.0",
    "description": "面向学生的课程、任务与日程管理工具。",
    "orientation": "portrait",
    "icon": "./assets/icon-final.png",
    "userInterfaceStyle": "automatic",
    "scheme": "shiguang",
    "ios": {
      "deploymentTarget": "26.0",
      "supportsTablet": false,
      "bundleIdentifier": "com.shiguang.studentplanner",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "拾光计划",
        "ITSAppUsesNonExemptEncryption": false,
        "NSDocumentsFolderUsageDescription": "用于选择并导入你的课程表文件。",
        "NSCameraUsageDescription": "用于拍摄并设置你的个人头像。",
        "NSPhotoLibraryUsageDescription": "用于从照片中选择并设置你的个人头像。"
      }
    },
    "android": {
      "package": "com.shiguang.studentplanner"
    },
    "plugins": [
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "用于从照片中选择并设置你的个人头像。",
          "cameraPermission": "用于拍摄并设置你的个人头像。",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
